# Copy this file to .env and fill in your key. .env is git-ignored — never commit it.

# OpenRouter API key (https://openrouter.ai/keys). Used to call Jev directly
# through OpenRouter's Decisions API — not the Jev Router.
OPENROUTER_API_KEY=

# The Jev decision model to invoke.
JEV_MODEL=typesafe/jev-1.14

# Chat model used only on the "race" slide, to compare speed and cost against Jev.
COMPARE_MODEL=anthropic/claude-sonnet-5.5
